# Copy to .env and fill with real values. .env is gitignored. Placeholders only below.
# Keep keys SERVER-SIDE only. Never put a key in the frontend, logs, or git history.

# --- Meta Model API (hosted) ---
# Values below are user-reported from the official docs (checked 28 Oct 2026) and
# must be RE-VERIFIED against the current console/docs and request schema before
# integration. The live adapter stays disabled until META_MODEL_API_VERIFIED=true
# AND the base URL is a real (non-placeholder) host.
META_MODEL_API_KEY=your_api_key_here
META_MODEL_API_BASE=https://api.meta.ai/v1          # re-verify before use
META_MODEL_API_VERIFIED=false
META_MODEL_ID=muse-spark-1.3                         # HOSTED text model (re-verify)
META_VOICE_MODEL=muse-voice-transcribe-1.0          # HOSTED transcription model (re-verify)

# --- Partner open-weights (SEPARATE; do NOT use as a hosted model id) ---
# meta-models/muse-spark-open-1026 is a partner-served open-weights identifier
# (e.g. Baseten), not a hosted Meta Model API model. Keep it out of META_MODEL_ID.
# BASETEN_API_KEY=your_baseten_key_here
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- App config ---
KNOWLEDGE_PACK=knowledge/policies.sample.json       # or knowledge/policies.json (real, unknowns)
DEMO_CLOCK_FILE=fixtures/demo_clock.json

# --- Enforced limits (hard guards in code; billing alerts are only notifications) ---
MAX_TOOL_CALLS_PER_TURN=3
MAX_REQUESTS_PER_SESSION=50
MAX_RETRIES=2
MAX_TIMEOUT_S=20
MAX_OUTPUT_TOKENS=512
