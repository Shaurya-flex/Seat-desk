# Copy to .env and fill with real values. .env is gitignored. Placeholders only below.

# --- Meta Model API (hosted) ---
# UNVERIFIED: resolve the real base URL and model id from the OFFICIAL Meta Model
# API docs / console under your hackathon account before integrating. Do NOT send
# your key to an illustrative endpoint. The live adapter refuses to run until
# META_MODEL_API_VERIFIED=true AND the base URL is a real (non-placeholder) host.
META_MODEL_API_KEY=your_api_key_here
META_MODEL_API_BASE=            # e.g. the base URL from the official Quickstart (leave blank until verified)
META_MODEL_API_VERIFIED=false
# Model id documented in the hackathon guide (Baseten section) for open weights:
META_MODEL_ID=meta-models/muse-spark-open-1026

# --- Optional: partner inference (open weights) ---
# BASETEN_API_KEY=your_baseten_key_here
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- App config ---
# Knowledge pack: knowledge/policies.json (real, mostly unknown) or
# knowledge/policies.sample.json (synthetic demo).
KNOWLEDGE_PACK=knowledge/policies.sample.json
DEMO_CLOCK_FILE=fixtures/demo_clock.json

# --- Enforced limits (hard guards in code; billing alerts are only notifications) ---
MAX_MODEL_RETRIES=2
MAX_TOOL_CALLS_PER_TURN=3
MAX_OUTPUT_TOKENS=512
MAX_REQUESTS_PER_SESSION=50
