# Copy to .env and fill with real values. .env is gitignored. Placeholders only below.
# Keep keys SERVER-SIDE only. Never put a key in the frontend, logs, or git history.

# --- Meta Model API (hosted) ---
# VERIFIED against the official docs at dev.meta.ai on 2 Nov 2026:
#   base URL        https://api.meta.ai/v1      (Bearer token in Authorization header)
#   endpoint        POST /chat/completions
#   output bound    max_completion_tokens       (`max_tokens` is a DEPRECATED alias)
#   reasoning       Muse Spark ALWAYS reasons. reasoning_effort "none" -> HTTP 400.
#                   Reasoning tokens are billed at the OUTPUT rate and share the
#                   output cap, so the cap must cover reasoning + visible JSON.
#   structured out  response_format {type:"json_schema", json_schema:{name,strict,schema}}
# Set META_MODEL_API_VERIFIED=true only while the above still matches the docs.
MODEL_API_KEY=your_api_key_here                     # the ONE key variable; scripts/live_once.py
#                                                   # loads this file explicitly (shell env wins)
META_MODEL_API_BASE=https://api.meta.ai/v1
META_MODEL_API_VERIFIED=true
META_MODEL_ID=muse-spark-1.3                        # Standard mode, hosted
META_VOICE_MODEL=muse-voice-transcribe-1.0          # POST /v1/asr/transcribe, $0.18/hour
META_REASONING_EFFORT=minimal                       # lowest supported on Muse Spark

# DELIBERATELY NOT USED: muse-spark-1.3-contributor. It is ~12x cheaper but
# requires permitting Meta to train on your content -- a data-use change.

# --- Partner open-weights (SEPARATE; do NOT use as a hosted model id) ---
# meta-models/muse-spark-open-1026 is a partner-served open-weights identifier
# (e.g. Baseten), not a hosted Meta Model API model. Keep it out of META_MODEL_ID.
# BASETEN_API_KEY=your_baseten_key_here
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- App config ---
KNOWLEDGE_PACK=knowledge/policies.sample.json       # or knowledge/policies.json (real, unknowns)
DEMO_CLOCK_FILE=fixtures/demo_clock.json

# --- Enforced limits (hard guards in code; billing alerts are only notifications) ---
MAX_TOOL_CALLS_PER_TURN=3
MAX_REQUESTS_PER_SESSION=50
MAX_RETRIES=2
MAX_TIMEOUT_S=20
MAX_OUTPUT_TOKENS=2048   # reasoning + visible output share this cap
