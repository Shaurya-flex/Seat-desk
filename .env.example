# Copy to .env and fill with real values. .env is gitignored. Placeholders only below.

# --- Meta Model API (hosted) ---
# Obtain from the Meta Model API console under the hackathon account.
META_MODEL_API_KEY=your_api_key_here
META_MODEL_API_BASE=https://api.example-meta-models.com/v1
META_MODEL_ID=meta-models/muse-spark-open-1026

# --- Optional: partner inference (open weights) ---
# BASETEN_API_KEY=your_baseten_key_here
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- App config ---
# Which knowledge pack to load: knowledge/policies.json (real, mostly unknown)
# or knowledge/policies.sample.json (synthetic demo data).
KNOWLEDGE_PACK=knowledge/policies.sample.json

# Explicit demonstration clock + timezone for deterministic availability.
DEMO_CLOCK_FILE=fixtures/demo_clock.json

# Safety bounds (notifications/guards, not hard billing caps).
MAX_MODEL_RETRIES=2
MAX_TOOL_CALLS_PER_TURN=3
MAX_OUTPUT_TOKENS=512
MAX_REQUESTS_PER_SESSION=50
